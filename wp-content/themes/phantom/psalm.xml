<?xml version="1.0"?>
<psalm
	errorLevel="5"
	resolveFromConfigFile="true"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="https://getpsalm.org/schema/config"
	xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
	<projectFiles>
		<directory name="app"/>
		<ignoreFiles>
			<directory name="vendor"/>
			<directory name="tests"/>
			<directory name="e2e"/>
		</ignoreFiles>
	</projectFiles>

	<!-- WordPress stubs (ADR-004): Phase 1 wires WP declarations into the
	     analysis so Psalm can police WP API misuse in app/; the Phase 0
	     global suppressions are removed. -->
	<stubs>
		<file name="vendor/php-stubs/wordpress-stubs/wordpress-stubs.php"/>
		<!-- Minimal WooCommerce API surface (Phase 9) — analysis-only stubs;
		     WC absent at runtime → adapters return inert defaults. -->
		<file name="tests/stubs/woocommerce-stubs.php"/>
	</stubs>
</psalm>
