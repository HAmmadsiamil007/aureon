{
  "name": "phantom/phantom-core",
  "version": "0.1.0",
  "description": "Phantom Core — token-driven frontend framework for WordPress, delivered as a GeneratePress child theme. GeneratePress, GP Premium, and WooCommerce remain untouched.",
  "type": "wordpress-theme",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "wordpress",
    "theme",
    "generatepress",
    "child-theme",
    "frontend-framework"
  ],
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpstan/phpstan": "^1.12",
    "squizlabs/php_codesniffer": "^3.11",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "vimeo/psalm": "^5.26",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "Phantom\\Core\\": "app/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "cs": "phpcs",
    "cs:fix": "phpcbf",
    "stan": "phpstan analyse --memory-limit=512M",
    "psalm": "psalm --no-cache",
    "check": [
      "@cs",
      "@stan",
      "@psalm"
    ]
  },
  "support": {
    "source": "https://github.com/example/phantom"
  }
}
