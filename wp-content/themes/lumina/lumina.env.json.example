{
  "$comment": "Lumina environment overrides (ADR-011). Copy to lumina.env.json (git-ignored). Values here override the PHP defaults in app/Config/config.php per environment. Never commit real secrets. Keys must match the config schema: environment.override, debug, features.*, log.*, error_handler.*, providers.",
  "environment": {
    "override": "production"
  },
  "debug": false,
  "features": {
    "lumina_core": true,
    "asset_pipeline": false
  },
  "log": {
    "level": "warning",
    "redact": ["ph_pass", "sku_key"]
  },
  "error_handler": {
    "register": true
  },
  "providers": []
}
