<?xml version="1.0"?>
<ruleset name="Lumina Core Coding Standards">
	<description>PHP_CodeSniffer ruleset for the Lumina Core child theme (WordPress Coding Standards).</description>

	<!-- Only scan our own source; never vendor or build output. -->
	<file>./app</file>
	<file>./inc</file>
	<file>./functions.php</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/assets/dist/*</exclude-pattern>

	<!-- WordPress Coding Standards (WPCS 3.x). -->
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<!-- Prefix hygiene: every global symbol uses the lumina_ prefix (ADR-002). -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="lumina"/>
			</property>
		</properties>
	</rule>

	<!-- PSR-4 autoloading (ADR-009) requires namespace-matching file names for
	     classes in app/ (e.g. app/Core/Version.php). WPCS filename conventions
	     apply only to non-namespaced theme/plugin files. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/app/*</exclude-pattern>
	</rule>

	<!-- ADR-006: the domain event bus deliberately uses the lumina_core:*
	     double-colon namespace (lumina_core:ready, lumina_core:boot_error).
	     WPCS prefers underscores, so the hook-name rule is scoped out of app/
	     where the domain bus lives. WP-boundary hooks keep underscores. -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<exclude-pattern>*/app/*</exclude-pattern>
	</rule>

	<!-- Text domain for all i18n strings. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="lumina"/>
			</property>
		</properties>
	</rule>

	<!-- PHP 8.2 baseline (ADR-012). -->
	<config name="testVersion" value="8.2-"/>
	<config name="minimum_supported_wp_version" value="6.5"/>

	<!-- Line length: WPC 100 hard, we allow up to 120 with 140 hard cap. -->
	<rule ref="Generic.Files.LineLength">
		<properties>
			<property name="lineLimit" value="120"/>
			<property name="absoluteLineLimit" value="140"/>
		</properties>
	</rule>
</ruleset>
