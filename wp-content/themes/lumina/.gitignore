# ── Dependencies ──────────────────────────────────────────────────────────────
/vendor/
/node_modules/

# ── Build output (Phase 7+ ships assets/dist; never commit source builds) ─────
/assets/dist/
/dist/

# ── Quality tool caches ───────────────────────────────────────────────────────
.phpstan/
.psalm/
.phpunit.cache/
.phpunit.result.cache
.php-cs-fixer.cache

# ── Environment / secrets (ADR-011) ───────────────────────────────────────────
lumina.env.json
.env
.env.*
!.env.example

# ── Local tooling binary (Composer phar, installed by scripts) ───────────────
composer.phar
tools/composer.phar

# ── OS / editor noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# ── WordPress runtime artifacts (never commit uploads) ────────────────────────
wp-content/uploads/
