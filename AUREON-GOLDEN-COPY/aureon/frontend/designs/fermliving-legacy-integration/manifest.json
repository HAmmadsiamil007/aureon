{
  "id": "fermliving",
  "label": "Ferm Living — Danish design client pack",
  "version": "1.0.0",
  "assets": {
    "css": [
      "css/fonts.css",
      "css/ferm.css"
    ],
    "js": [
      { "file": "js/ferm.js", "deps": ["aether-main"] }
    ]
  },
  "components": {
    "overrides": {
      "shell/header": "components/shell/header.php",
      "shell/mobile-chrome": "components/shell/mobile-chrome.php",
      "shell/footer": "components/shell/footer.php",
      "shell/preloader": "components/shell/preloader.php",
      "shell/announcement": "components/shell/announcement.php",
      "content/author-bio": "components/content/author-bio.php",
      "card/product": "components/cards/product.php",
      "card/category": "components/cards/category.php",
      "product/gallery": "components/product/gallery.php",
      "product/info": "components/product/info.php"
    }
  },
  "sections": {
    "hero": "sections/section-hero.php",
    "bestsellers": "sections/section-bestsellers.php",
    "categories": "sections/section-categories.php",
    "ferm-editorial-split": "sections/section-editorial-split.php",
    "ferm-room-grid": "sections/section-room-grid.php"
  },
  "composition": {
    "file": "composer.php",
    "hooks": [
      "aether_frontpage_sections",
      "aether_adapter_shop_hero_data",
      "aether_adapter_about_data"
    ]
  },
  "mappings": {
    "ui": [
      { "client": "Split hero: 2-up full-height media panels, cream titles bottom-left + outlined Shop Now", "aether": "section/hero (shadowed)" },
      { "client": "Frontpage products row: left-aligned h2 + 4-col product card grid on cream", "aether": "section/bestsellers (shadowed)" },
      { "client": "Homepage room tiles: edge-to-edge image cards, name overlaid bottom-left", "aether": "section/categories (shadowed -> ferm room grid)" },
      { "client": "USP announcement bar (rotating carousel)", "aether": "shell/announcement" },
      { "client": "Fixed header: logo left, nav center, icons right + mega menu", "aether": "shell/header (override)" },
      { "client": "Mobile drawer + 3-level submenu panels", "aether": "shell/mobile-chrome" },
      { "client": "Footer: USP row + newsletter + 3 link columns + legal", "aether": "shell/footer (override)" },
      { "client": "Homepage category image grid (2x2 tiles)", "aether": "section/categories (styled)" },
      { "client": "Category image tiles row (full-bleed overlay)", "aether": "card/category (override)" },
      { "client": "Product card: image carousel, badges, heart, swatches, +Add to Cart", "aether": "card/product (override)" },
      { "client": "Text-image editorial split bands", "aether": "section/story + section/features" },
      { "client": "Collection toolbar + product grid", "aether": "section/shop-grid + section/shop-filter" },
      { "client": "Product gallery (image carousel + dots)", "aether": "product/gallery" },
      { "client": "Product info (title, price, swatches, size, qty, CTA)", "aether": "product/info" },
      { "client": "Product accordion (description, shipping, care)", "aether": "section/accordion" },
      { "client": "Newsletter signup (Klaviyo-style)", "aether": "form/newsletter" },
      { "client": "Blog grid (3-col image + title + date)", "aether": "card/blog" },
      { "client": "Article hero + body + author bio", "aether": "content/article-hero + article-body + author-bio" },
      { "client": "Cart drawer (slide-out, upsell)", "aether": "cart/items + cart/summary" },
      { "client": "Room landing grid (image cards + product links)", "aether": "section/features" },
      { "client": "Instagram/UGC feed", "aether": "section/newsletter (alternative)" }
    ],      "components": [
      "shell/header",
      "shell/mobile-chrome",
      "shell/footer",
      "shell/preloader",
      "shell/announcement",
      "content/author-bio",
      "card/product",
      "card/category",
      "product/gallery",
      "product/info"
    ]
  },
  "data": {
    "required": ["site", "header", "menu", "announcement", "hero", "wc-products", "wc-categories", "blog", "newsletter", "footer"],
    "optional": ["product", "cart", "account", "order", "contact", "faq", "team", "testimonials", "wishlist", "auth", "coming-soon", "shop-hero", "wc-filter", "article"]
  },
  "integrations": {
    "wordpress": ["nav menus", "pages", "blog"],
    "woocommerce": ["shop grid", "product cards", "categories", "cart", "checkout", "account"],
    "plugins": ["aureon newsletter", "aureon ajax", "aureon analytics"]
  },
  "js": {
    "platform": ["animations.js (motion watchdog)", "main.js (AJAX cart, contact, newsletter, cart-count, search, drawer)"],
    "design": {
      "ferm.js": "guarded header hide-on-scroll/show-on-up + USP rotation + mega menu hover + reduced motion respect",
      "classification": "KEEP platform js; ADAPT none; REPLACE none; EXCLUDE Shopify/Clerk/Klaviyo/Cookiebot/ablyft/monorail/analytics/Struct/Flowbox from source"
    }
  },
  "customizer": {
    "tokens": [
      "--color-bg(cream #FFFEFA)",
      "--color-surface(#FFFFFF)",
      "--color-surface-2(canvas #F7F5EF)",
      "--color-text(#383838)",
      "--color-muted(#666666)",
      "--color-accent(green #587664)",
      "--color-border(#DCD3CB)",
      "--font-heading(CanelaText serif)",
      "--font-body(KHTeka sans-serif)",
      "--container-max(1920px)",
      "--grid-gap(24px)"
    ],
    "controls": ["colors", "typography", "announcement items", "footer USP row", "footer columns", "section toggles", "motion toggles"]
  },
  "source_audit": {
    "total_pages": 980,
    "template_families": 12,
    "unique_collections": 80,
    "products": 784,
    "blog_articles": 17,
    "configurators": "unsupported (Struct.com)",
    "font_licensing": "commercial — client-licensed (CanelaText + KHTeka)",
    "css_framework": "Tailwind CSS (compiled, will be replaced by tokenized CSS)",
    "js_framework": "Lightweight custom (Embla carousel, no GSAP/Swiper)",
    "animation_level": "minimal — CSS transitions only",
    "third_party_excluded": ["Shopify CDN", "Ablyft", "Cookiebot", "Klaviyo", "Swym", "Clerk.io", "Flowbox", "Struct.com", "Trusted Shops", "Stape GTM"]
  }
}
