{
  "name": "aether-frontend-tests",
  "version": "1.0.0",
  "private": true,
  "description": "AETHER premium frontend E2E verification — routes, interactions, failure injection, accessibility, visual regression.",
  "scripts": {
    "test": "playwright test",
    "test:routes": "playwright test specs/routes.spec.js",
    "test:interactions": "playwright test specs/interactions.spec.js",
    "test:failure": "playwright test --grep @failure",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.48.2"
  }
}
